# Required
DATABASE_URL=postgresql://user:password@host/dbname
OPENAI_API_KEY=your-openai-api-key

# Optional
OPENAI_MODEL=gpt-4o-mini
UNSPLASH_ACCESS_KEY=your-unsplash-access-key

# S2 enrichment safety defaults. Publisher/body display rights are managed
# separately through scripts/manage_s2_source_policy.py.
ENRICH_CROSS_SOURCE_ANALYSIS=false
ENRICH_STOCK_IMAGES=false
ENRICH_GENERATED_IMAGES=false
# S3 requires an explicit schema migration, DB budget and recipe enablement.
# Consumer activation additionally requires passing reviewed promotion evidence.
S3_WORKER_ENABLED=false
S3_CONSUMERS_ENABLED=false
# S4 remains off until explicit schema, quality, budget and rollout gates pass.
S4_WORKER_ENABLED=false
S4_CONSUMERS_ENABLED=false
# S5 is separately activated after additive schema and hosted validation.
# Lexical serving makes no model calls; migration requires reader confirmation.
S5_READER_ENABLED=false
# Optional per-intent embeddings need an approved S3 recipe AND explicit positive
# DB token budgets. Neither the API process nor a feed request runs this worker.
S5_WORKER_ENABLED=false
S5_SEMANTIC_ENABLED=false
# Intentionally unset: provide a measured threshold before semantic activation.
# S5_SEMANTIC_MIN_SIMILARITY=

# S6 shadow uses current pool + canonical S5 profiles; no request-time providers.
# Provision indexes explicitly with scripts/manage_s6_retrieval.py first.
S6_SHADOW_ENABLED=false
S6_DENSE_ENABLED=false
S6_ANN_ENABLED=false
# Explicit measured threshold required; missing/invalid means dense abstains.
# S6_MIN_SIMILARITY=
# S6 serving requires the S7 adapter and its independent configuration gates.
# Shadow never changes the feed.
S6_SERVING_ENABLED=false

# S7 installation/configuration is explicit via scripts/manage_s7_ranking.py.
# Defaults never spend, serve a new ranking, or refresh in the background.
# Serving also requires canonical S5 + S6 and an approved database recipe.
S7_SHADOW_ENABLED=false
S7_SERVING_ENABLED=false
# Provider enablement ALSO needs a supported priced snapshot and positive global
# and per-account dollar budgets in ranking_control. GET/chat never call it.
S7_PROVIDER_ENABLED=false
S7_BACKGROUND_ENABLED=false

# S8 reuses S7 judgments/storage; assembly itself makes zero provider calls.
# Explicit schema/configuration via scripts/manage_s8_assembly.py is required.
# Serving additionally needs S5/S6/S7, a compatible iOS client, SQL/quality gates.
# S3 membership remains separately disabled in assembly.recipe.example.json.
S8_SERVING_ENABLED=false
