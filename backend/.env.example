# Required
DATABASE_URL=postgresql://user:password@host/dbname
OPENAI_API_KEY=your-openai-api-key

# Optional
OPENAI_MODEL=gpt-4o-mini
UNSPLASH_ACCESS_KEY=your-unsplash-access-key

# S2 enrichment safety defaults. Publisher/body display rights are managed
# separately through scripts/manage_s2_source_policy.py.
ENRICH_CROSS_SOURCE_ANALYSIS=false
ENRICH_STOCK_IMAGES=false
ENRICH_GENERATED_IMAGES=false
# S3 requires an explicit schema migration, DB budget and recipe enablement.
# Consumer activation additionally requires passing reviewed promotion evidence.
S3_WORKER_ENABLED=false
S3_CONSUMERS_ENABLED=false
