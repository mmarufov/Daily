# Deployment inputs for daily-web, whose Root Directory is web.
# Backend inclusions match scripts/stage-lab-evidence.ts; a test checks that set.

/Daily
/DailyTests
/DailyUITests
/Daily.xcodeproj
/scripts
/docs
/.context
/.conductor
/.github
/.claude

# Everything under backend/, except the evidence the Lab functions stage.
# A parent directory cannot be re-included once excluded, hence the walk.
/backend/*
!/backend/lab
!/backend/app
/backend/lab/*
!/backend/lab/__init__.py
!/backend/lab/harness.py
!/backend/lab/cases
!/backend/lab/contract
/backend/lab/contract/*
!/backend/lab/contract/types.py
!/backend/lab/contract/versions
/backend/app/*
!/backend/app/services
/backend/app/services/*
!/backend/app/services/openai_service.py
!/backend/app/services/ranking_contract.py

# Exclude browser acceptance artifacts.
/web/test-results
/web/playwright-report
