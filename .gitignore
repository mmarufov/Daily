*.dSYM

# ---- Python ------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
venv/
.venv/

# ---- Secrets -----------------------------------------------------------
# Real credentials live in Fly.io secrets and an untracked local .env.
.env
.env.*
*.env
!.env.example

# ---- CI scratch --------------------------------------------------------
*-results.xml

# ---- Regenerable eval data --------------------------------------------
# Rebuild: python evals/build_corpus.py
backend/evals/corpus.json
backend/evals/.cache/emb_*.pkl

# ---- Agent / tooling working directories -------------------------------
# Local scratch used by coding agents; never part of the project.
.context/
.conductor/settings.local.*
.gstack/
.claude/settings.local.json
.tmp/
*.tmp
*.temp
.enc.temp

# ---- Unrelated local artifacts -----------------------------------------
# Scratch output from unrelated one-off tasks run in this working copy.
artifacts/
# ...but the web tier's exported evaluation artifacts are committed on purpose:
# they are what lets the explorer and the reader demo render with no credentials,
# and CI asserts the commit stays in sync with the harness.
!web/public/artifacts/
!web/public/demo/
node_modules/
*.pptx
*.inspect.ndjson

.vercel
.playwright-mcp/

# Dev-server output and browser-tool scratch. Committed by accident in #65 and
# #66 when a dev server ran from the repo root rather than from web/. Both
# rebuild on every run, and .next is why GitHub reported this repo as mostly
# JavaScript when it has 78 bytes of first-party JS outside that folder.
.next/
.swc/
